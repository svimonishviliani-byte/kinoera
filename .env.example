# Copy this file to .env, then fill in your own Supabase project values
# (Project Settings -> API in the Supabase dashboard).
#
# Until these are set, Konoera.ge runs in local demo mode: the bundled
# sample catalog is shown, and login / register / admin explain that
# auth isn't configured yet instead of breaking.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
